---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import SlideThumbnail from '../components/SlideThumbnail';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const slides = (await getCollection('slide')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 960px;
			}
			ul {
				display: flex;
				flex-wrap: wrap;
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				width: calc(33.333% - 1.334rem);
			}
			ul li * {
				text-decoration: none;
				transition: 0.2s ease;
			}
			ul li a {
				display: block;
			}
			.thumbnail-wrapper {
				border-radius: 12px;
				overflow: hidden;
			}
			ul li a:hover .thumbnail-wrapper {
				box-shadow: var(--box-shadow);
			}
			.title {
				margin: 0.5rem 0 0;
				color: rgb(var(--black));
				line-height: 1.2;
				font-size: 1rem;
			}
			.date {
				margin: 0.25rem 0 0;
				color: rgb(var(--gray));
				font-size: 0.875rem;
			}
			ul li a:hover .title,
			ul li a:hover .date {
				color: rgb(var(--accent));
			}
			.empty {
				color: rgb(var(--gray));
			}
			@media (max-width: 720px) {
				ul {
					gap: 0.5em;
				}
				ul li {
					width: 100%;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				{
					slides.length === 0 ? (
						<p class="empty">No slides yet.</p>
					) : (
						<ul>
							{slides.map((slide) => (
								<li>
									<a href={`/Slide/${slide.id}/`}>
										<div class="thumbnail-wrapper">
											<SlideThumbnail
												client:only="react"
												pdfUrl={`/pdf/${slide.data.pdfFile}`}
											/>
										</div>
										<h4 class="title">{slide.data.title}</h4>
										<p class="date">
											<FormattedDate date={slide.data.pubDate} />
										</p>
									</a>
								</li>
							))}
						</ul>
					)
				}
			</section>
		</main>
		<Footer />
	</body>
</html>
